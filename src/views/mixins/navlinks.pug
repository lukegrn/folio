include ./ainote.pug

mixin navlinks(page)
  style.
    .navlinks {
      display: flex;
      height: 100%;
      flex-direction: column;
    }

    .navlinks > .link:hover {
      background-color: var(--accent-bg-color);
      font-weight: 500;
    }

    .navlinks > .link {
      color: var(--primary-fg-color);
      text-decoration: none;
      margin-right: 2rem;
      padding-left: 0.3rem;
    }

    .navlinks > .link:visited {
      color: var(--primary-fg-color);
    }

    .navlinks > .link.active {
      color: var(--accent-fg-color);
      background-color: var(--accent-bg-color);
    }
    .navlinks > .end {
      margin-top: auto;
    }

  .navlinks
    a.link(href="/", class=page == "home" ? "active" : "inactive") Home
    a.link(href="/photography", class=page == "photography" ? "active" : "inactive") Photography
    a.link(href="/posts", class=page == "posts" ? "active" : "inactive") Posts
    a.link(href="/toolbox", class=page == "toolbox" ? "active" : "inactive") Toolbox
    a.link(href="/contact", class=page == "contact" ? "active" : "inactive") Contact Me
    .end
      +ainote("2.5rem")
        span
          | Lots of people feels lots of ways about AI.
          | In general, things on this website are ways I express
          |
          em my
          |
          | creativity and exercise
          |
          em my
          |
          | brain.
          | To that effect, I don't anticipate any AI use, but if it is used (or linked to), it will be marked by this symbol, likely also with an explanation.
