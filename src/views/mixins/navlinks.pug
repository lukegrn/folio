mixin navlinks(page)
  style.
    .navlinks {
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .navlinks > .link:hover {
      background-color: var(--accent-bg-color);
      font-weight: 500;
    }

    .navlinks > .link {
      color: var(--primary-fg-color);
      text-decoration: none;
      margin-right: 2rem;
      padding-left: 0.3rem;
    }

    .navlinks > .link:visited {
      color: var(--primary-fg-color);
    }

    .navlinks > .link.active {
      color: var(--accent-fg-color);
      background-color: var(--accent-bg-color);
    }

  .navlinks
    a.link(href="/", class=page == "home" ? "active" : "inactive") Home
    a.link(href="/contact", class=page == "contact" ? "active" : "inactive") Contact Me
    a.link(href="/photography", class=page == "photography" ? "active" : "inactive") Photography
    a.link(href="/posts", class=page == "posts" ? "active" : "inactive") Posts
    a.link(href="/toolbox", class=page == "toolbox" ? "active" : "inactive") Toolbox
